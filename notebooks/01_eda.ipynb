   "source": [
    "## Correlation inspection\n",
 # Convert the binary target to numeric for correlation analysis.
corr_data = df.copy()
corr_data["Revenue"] = corr_data["Revenue"].astype(int)

# Keep numeric features and the numeric target.
numeric_for_corr = corr_data.select_dtypes(include="number")

# Calculate correlations.
corr = numeric_for_corr.corr()

print("Correlation matrix:")
display(corr.round(3))

print("Correlation with Revenue:")
revenue_corr = (
    corr["Revenue"]
    .drop("Revenue")
    .sort_values(key=abs, ascending=False)
    .to_frame("correlation_with_Revenue")
)
display(revenue_corr.round(3))

# Visualize the correlations with the target.
ax = revenue_corr.sort_values(
    "correlation_with_Revenue"
).plot(
    kind="barh",
    figsize=(8, 6),
    legend=False,
    title="Numeric feature correlation with Revenue"
)
ax.set_xlabel("Pearson correlation")
plt.tight_layout()
plt.show()

