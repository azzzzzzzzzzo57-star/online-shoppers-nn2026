   "source": [
    "numeric = df.select_dtypes(include='number')\n",
    "numeric.hist(figsize=(15, 11), bins=30)\n",
    "plt.suptitle('Numerical feature distributions')\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
